# RB Agent OS Environment Configuration
# Project Owner: Ram Binay Kumar Pandit
# Port and Server Configuration
PORT=8765
HOST=127.0.0.1
DEBUG=false

# Default AI Provider Configuration
# Supported providers: gemini, openai, anthropic, ollama
ACTIVE_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional OpenAI / Compatible
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Persistence
DATABASE_PATH=rb_agent.db

# Optional Cloud Persistence (Supabase)
# Configured URL from specification
SUPABASE_URL=https://sjkpzpglpfgjhuzjkseb.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SYNC_ENABLED=false

# Security & Workspace
WORKSPACE_DIR=workspace
MAX_OUTPUT_BYTES=500000
EXECUTION_TIMEOUT_SECONDS=30
ALLOW_UNSAFE_SHELL=false
